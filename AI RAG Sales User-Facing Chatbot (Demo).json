    {
      "parameters": {
        "content": "## Phase 2: Process Each File, Contextualize, Add Metadata, and Store in Supabase Vector Database…\n\n",
        "height": 800,
        "width": 2896,
        "color": 6
      },
      "type": "n8n-nodes-base.stickyNote",
